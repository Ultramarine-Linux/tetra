[Unit]
Description={{ site_title }} web site

[Container]
ContainerName={{ app_id }}
Image=docker.io/library/nginx:alpine@sha256:a3554c0d0b48177b1413c26e01f695334428020d9df01243fbae3e11cfd17417
PublishPort={{ host_port }}:80
Volume={{ bundle_dir }}:/usr/share/nginx/html:ro
Volume={{ bundle_dir }}/default.conf:/etc/nginx/conf.d/default.conf:ro

[Service]
Restart=always

[Install]
WantedBy=default.target
