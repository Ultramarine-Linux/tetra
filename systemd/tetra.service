[Unit]
Description=Tetra Host Agent
Requires=tetra.socket
After=tetra.socket
# No network-online.target: clients come over the Unix socket, and the OOBE
# needs Tetra to bring the network up in the first place (Wi-Fi). The
# outbound control-plane connection retries with backoff until it is up.

[Service]
Type=simple
ExecStart=/usr/bin/tetra agent-serve --identity-dir /var/lib/tetra/identity
ExecReload=/bin/kill -HUP $MAINPID
# Web shells are transient units of their own; a shell that ignores SIGHUP
# must not outlive Tetra. (The next start also sweeps leftovers.)
ExecStopPost=-/usr/bin/systemctl stop --no-block --no-ask-password tetra-shell-*.service
Restart=on-failure
RestartSec=5
# Credentials, grants, sessions, the setup marker and the dashboard's
# pam_faillock tally. Root only.
StateDirectory=tetra tetra/faillock
StateDirectoryMode=0700

[Install]
WantedBy=multi-user.target
Also=tetra.socket
