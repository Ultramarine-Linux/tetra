[Unit]
Description=Tetra Host Agent
Requires=tetra.socket
After=tetra.socket network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment="RUST_LOG=info"
Environment="TETRA_IDENTITY_DIR=/var/lib/tetra/identity"
ExecStart=/usr/bin/tetra agent-serve --identity-dir /var/lib/tetra/identity
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
Also=tetra.socket
